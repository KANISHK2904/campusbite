# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusbite

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── College email domain restriction (without @) ─────────────────────────────
# Example: college.edu  → only user@college.edu emails are allowed
ALLOWED_EMAIL_DOMAIN=college.edu

# ── Razorpay (Test Mode keys from razorpay.com/dashboard) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Client URL (for CORS + OAuth redirect) ───────────────────────────────────
CLIENT_URL=http://localhost:5173
